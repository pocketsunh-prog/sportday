/mobile/gradle

# Local environment for `docker compose` — holds the database and JWT passwords.
# .env.example is the committed template; .env is yours and never goes upstream.
/.env
/.env.*
!/.env.example

# Build output
/backend/target/
/frontend/.next/
/frontend/out/
# A Next build run from the repository root writes here rather than under frontend/.
/.next/
/frontend/next-env.d.ts

# Compiled Python. The sample generator and the smoke test are scripts, not a package.
__pycache__/
*.pyc

# Local run artefacts
/artifacts/
/backend/app-run.log

# Season backups written by a season reset before it deletes anything.
# Contains a copy of the entries, marks and school records, so it is
# deliberately not committed. The application is started from backend/, so its
# default `backups/` lands there rather than at the repository root — both paths
# are listed, because an anchored pattern only matches the depth it names.
/backups/
/backend/backups/

# Local database dump taken before the revamp migration.
# Contains a copy of real register data, so it is deliberately not committed.
/db-backup/

# Editor / OS noise
.DS_Store
Thumbs.db

# Release signing: the key and its password never go in the repository.
mobile/keystore.properties
*.jks
*.keystore
