# ---------------------------------------------------------------------------
# SportDay — copy this file to .env and edit it.
#
#   cp .env.example .env        (Windows: copy .env.example .env)
#   docker compose up -d --build
#
# .env is git-ignored. The values below are the *defaults built into*
# docker-compose.yml, so a .env that only uncomments a line changes nothing
# except that line. The passwords here are LOCAL PLACEHOLDERS — change them
# before this is reachable by anybody but you.
# ---------------------------------------------------------------------------

# --- MySQL ---------------------------------------------------------------
MYSQL_ROOT_PASSWORD=root123
MYSQL_DATABASE=sportday
MYSQL_USER=sportday
MYSQL_PASSWORD=sportday123
# Host port the database is published on (container port is always 3306).
MYSQL_HOST_PORT=3307

# --- Backend -------------------------------------------------------------
BACKEND_PORT=8080
# Signs every login token. Anyone holding it can mint an admin token.
# Generate one with:  openssl rand -base64 48
JWT_SECRET=sportdaySecretKeyForJwtTokenGenerationMustBeAtLeast256BitsLong1234567890
# Token lifetime in milliseconds (86400000 = 24 hours).
JWT_EXPIRATION=86400000
# Sample students to create on a fresh database (0 = none).
SEED_SAMPLE_STUDENTS=0

# --- Frontend ------------------------------------------------------------
FRONTEND_PORT=3000
# The API URL the BROWSER uses. It is compiled into the bundle at image build
# time, so after changing it run:  docker compose build frontend
# It must be reachable from the machine running the browser. It may be a host
# name or a reverse proxy in front of the backend; it must NOT be a Docker
# service name such as http://backend:8080/api, which no browser can resolve.
NEXT_PUBLIC_API_URL=http://localhost:8080/api

# --- Misc ----------------------------------------------------------------
TZ=UTC
