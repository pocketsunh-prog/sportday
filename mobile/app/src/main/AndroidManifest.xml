<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Networking only. There is deliberately no storage permission here.

        minSdk is 24 and targetSdk is 35, so:
          * the results PDF is inserted into MediaStore.Downloads on API 29+,
            which an app may do with no permission because it created the file;
          * on API 24-28 it is written to the app's own external files directory,
            which also needs no permission;
          * WRITE_EXTERNAL_STORAGE would be ignored from API 29 and is not
            requested even for the older path, because the app never writes
            outside its own directory there.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
        Fingerprint and face unlock, through androidx.biometric. USE_FINGERPRINT
        is the deprecated spelling and is deliberately not requested; this one
        covers both kinds of sensor. It is a normal permission, so it is granted
        at install with no prompt. Nothing else was added: the credential is
        sealed with an Android Keystore key, which needs no permission at all.
    -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="SportDay"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SportDayMobile"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Lets the phone's PDF viewer, or a share target, read a results PDF the
            app saved in its own directory on API 24-28. FileProvider grants the
            receiving app a one-off read on the URI, so no permission is needed on
            either side. On API 29+ the file is served by MediaStore instead.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
